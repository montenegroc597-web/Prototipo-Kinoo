# Copia este archivo como .env y llena lo que tengas. Nunca subas .env al repositorio.
# TMDB (themoviedb.org → Configuración → API). Para traer el catálogo de 300 películas.
TMDB_API_KEY=
# Anthropic (opcional): para etiquetar el catálogo en lote con el juez sintético.
ANTHROPIC_API_KEY=
# Supabase del PRODUCTO (no el de las pruebas de usabilidad).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo sesiones en la nube: Chromium ya instalado para las e2e.
PW_CHROMIUM_PATH=
