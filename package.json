{
  "name": "kinoo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:functions": "node scripts/build-functions.mjs",
    "check:site": "node scripts/check-site.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "sim": "tsx packages/engine/sim/run.ts",
    "seed": "node scripts/seed/generate-seed.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.7.5",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
